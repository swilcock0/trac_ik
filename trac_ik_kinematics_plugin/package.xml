<?xml version="1.0"?>
<package format="3">
  <name>trac_ik_kinematics_plugin</name>
  <version>1.6.6</version>
  <description>A MoveIt 2 Kinematics plugin using TRAC-IK</description>
  <maintainer email="aprotyas@u.rochester.edu">Abrar Rahman Protyasha</maintainer>
  <author>Patrick Beeson</author>
  <license>BSD</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>moveit_core</depend>
  <depend>pluginlib</depend>
  <depend>tf2</depend>
  <depend>tf2_kdl</depend>
  <depend>trac_ik_lib</depend>

  <build_depend>nlopt</build_depend>

  <exec_depend>nlopt</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <moveit_core plugin="${prefix}/trac_ik_kinematics_description.xml"/>
  </export>
</package>
